# Copy to .env (gitignored) and fill in. Never commit .env.

# Extractor (Phase 2): Gemini API key from Google AI Studio.
GEMINI_API_KEY=

# `jobfinder alerts`: the mailbox that receives LinkedIn job alerts.
# Use a Gmail app password (Google Account > Security > App passwords), never the account password.
# A mailbox used only for alerts keeps the app password away from personal mail.
ALERTS_EMAIL_ACCOUNT=
ALERTS_EMAIL_APP_PASSWORD=

# Daily digest (Phase 3).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
